# Copy to app.env (gitignored). No quotes around values.
# User, password and database must match postgres.env; `postgres` is the in-cluster Service.
DATABASE_URL=postgresql://todo:change-me@postgres:5432/todo
# A long random value, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me
# Optional: NestJS Observe keys (from your local .env).
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
