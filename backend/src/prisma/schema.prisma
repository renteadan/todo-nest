generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  completedAt DateTime? @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  description String?
  id          Int       @id @default(autoincrement())
  taskListId  Int?
  title       String
  updatedAt   DateTime  @db.Timestamptz(3)
  userId      Int
  /// Deleting a list keeps its tasks, outside any list.
  TaskList    TaskList? @relation(fields: [taskListId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  User        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([taskListId], map: "Task_taskListId_idx_ec08b633")
  @@index([userId])
}

model TaskList {
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  id        Int      @id @default(autoincrement())
  title     String
  updatedAt DateTime @db.Timestamptz(3)
  userId    Int
  Task      Task[]
  User      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "TaskList_userId_idx_a489d58a")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  name      String?
  password  String
  salt      String
  role      Role       @default(USER)
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @db.Timestamptz(3)
  TaskList  TaskList[]
  Task      Task[]
}

enum Role {
  USER
  ADMIN
}

model RefreshToken {
  /// SHA-256 of the token, computed by @nestjs/authentication.
  id              String    @id
  familyId        String
  /// The library's string user id; no foreign key (see TokenService.issue()).
  userId          String
  createdAt       DateTime  @db.Timestamptz(3)
  expiresAt       DateTime  @db.Timestamptz(3)
  familyExpiresAt DateTime  @db.Timestamptz(3)
  usedAt          DateTime? @db.Timestamptz(3)
  claims          Json?

  @@index([familyId])
  @@index([userId])
  @@index([familyExpiresAt])
}

/// Kept apart from RefreshToken so a revocation also covers tokens of the
/// family saved after it (a rotation that lost the race to a reuse).
model RevokedRefreshTokenFamily {
  familyId        String   @id
  familyExpiresAt DateTime @db.Timestamptz(3)

  @@index([familyExpiresAt])
}
